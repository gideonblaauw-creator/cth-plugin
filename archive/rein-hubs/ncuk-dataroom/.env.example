# Copy to .env.generated on the VPS via scripts/deploy-prep.sh (Infisical → local env).
# Never commit .env.generated. Values below are placeholders only.

# Infisical project: cth-agents (prod). Keys fetched by deploy-prep.sh:
#   NCUK_DATAROOM_BASIC_AUTH_PASSWORD
#   NCUK_DATAROOM_BASIC_AUTH_USER (optional; default rein)
#   NCUK_DOCMOST_APP_SECRET
#   NCUK_DOCMOST_DB_PASSWORD
#   NCUK_DOCMOST_VIEWER_PASSWORD (operator setup; not used by compose)

APP_URL=https://dataroom.cleantechhub.net
APP_SECRET=REPLACE_VIA_INFISICAL
POSTGRES_PASSWORD=REPLACE_VIA_INFISICAL
DATABASE_URL=postgresql://docmost:REPLACE_VIA_INFISICAL@ncuk-dataroom-db:5432/docmost

# Caddy edge (written to caddy.env by deploy-prep.sh)
NCUK_BASIC_AUTH_USER=rein
NCUK_BASIC_AUTH_HASH=REPLACE_VIA_CADDY_HASH_PASSWORD

# docmost | fallback — switch to fallback if Docmost unhealthy by 27 Oct 2026
NCUK_ROOM_MODE=docmost
