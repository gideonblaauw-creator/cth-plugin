{% import "macros.njk" as ex %}
<section class="cth-slide cth-slide--media-proof" data-cth-type="media-proof">
  <div class="cth-slide__head"><h2 class="cth-title">{{ title }}</h2>{{ ex.exBadge() }}</div>
  <div class="cth-slide__body cth-media-proof">
    <div class="cth-phone">{% if example %}{{ ex.phImg("min-height:10rem;") }}{% endif %}</div>
    <div class="cth-panel">
      <p><strong>{{ outlet }}</strong></p>
      <p style="font-size:0.65em;">{{ url }}</p>
    </div>
  </div>
  {% if notes %}<aside class="notes">{{ notes }}</aside>{% endif %}
</section>