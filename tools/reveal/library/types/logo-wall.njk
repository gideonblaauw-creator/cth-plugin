{% import "macros.njk" as ex %}
<section class="cth-slide cth-slide--logo-wall" data-cth-type="logo-wall">
  <div class="cth-slide__head">
    <h2 class="cth-title">{{ title }}</h2>
    {% if group %}<p class="cth-subtitle">{{ group }}</p>{% endif %}
    {{ ex.exBadge() }}
  </div>
  <div class="cth-slide__body cth-logo-wall">
    {% for logo in logos %}
    {% if logo.src %}<img src="{{ logo.src }}" alt="{{ logo.alt }}" class="cth-logo-wall__img" style="object-fit:contain;padding:0.25rem;" />{% elif example %}
    <div class="cth-ph-logo" aria-label="{{ logo.alt }}">{{ logo.alt }}</div>
    {% endif %}
    {% endfor %}
  </div>
  {% if notes %}<aside class="notes">{{ notes }}</aside>{% endif %}
</section>