{% import "macros.njk" as ex %}
<section class="cth-slide cth-slide--offer" data-cth-type="offer">
  <div class="cth-slide__head"><h2 class="cth-title">{{ title }}</h2>{{ ex.exBadge() }}</div>
  <div class="cth-slide__body cth-offer{% if not image and not example %} cth-offer--single{% endif %}">
    <div class="cth-panel">
      <p class="cth-offer__price"><span class="cth-offer__currency">{{ currency }}</span> {{ price }}</p>
      <ul class="cth-bullets">{% for item in includes %}<li>{{ item }}</li>{% endfor %}</ul>
      {% if note %}<p class="cth-table-note">{{ note }}</p>{% endif %}
    </div>
    {% if image or example %}
    <div>{% if image %}<img src="{{ image }}" alt="" />{% else %}{{ ex.phImg("min-height:10rem;") }}{% endif %}</div>
    {% endif %}
  </div>
  {% if notes %}<aside class="notes">{{ notes }}</aside>{% endif %}
</section>