{% import "macros.njk" as ex %}
<section class="cth-slide cth-slide--partner-profile" data-cth-type="partner-profile">
  {{ ex.exBadge() }}
  <div class="cth-split">
    {% if example %}{{ ex.phImg("min-height:12rem;") }}{% endif %}
    <div>
      {% if example %}{{ ex.phLogo("Example", "max-width:40%;margin-bottom:0.5rem;") }}{% endif %}
      <h2 class="cth-title">{{ name }}</h2>
      <p>{{ text }}</p>
    </div>
  </div>
  {% if notes %}<aside class="notes">{{ notes }}</aside>{% endif %}
</section>