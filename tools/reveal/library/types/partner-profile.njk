<section class="cth-slide cth-slide--partner-profile" data-cth-type="partner-profile">
  <span class="cth-badge-example">Example</span>
  <div class="cth-split">
    <div class="cth-ph-img" style="min-height:12rem;">Example</div>
    <div>
      <div class="cth-ph-logo" style="max-width:40%;margin-bottom:0.5rem;">Example</div>
      <h2 class="cth-title">{{ name }}</h2>
      <p>{{ text }}</p>
    </div>
  </div>
  {% if notes %}<aside class="notes">{{ notes }}</aside>{% endif %}
</section>