{% import "macros.njk" as ex %}
<section class="cth-slide cth-slide--data-table" data-cth-type="data-table">
  <div class="cth-slide__head"><h2 class="cth-title">{{ title }}</h2>{{ ex.exBadge() }}</div>
  <div class="cth-slide__body cth-table-wrap">
    <table class="cth-table">
      <thead><tr>{% for col in columns %}<th>{{ col }}</th>{% endfor %}</tr></thead>
      <tbody>{% for row in rows %}<tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>{% endfor %}</tbody>
    </table>
    <p class="cth-source">Source: {{ source }}</p>
    {% if note %}<p class="cth-table-note">{{ note }}</p>{% endif %}
  </div>
  {% if notes %}<aside class="notes">{{ notes }}</aside>{% endif %}
</section>