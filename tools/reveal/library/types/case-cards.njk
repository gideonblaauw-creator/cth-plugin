{% import "macros.njk" as ex %}
<section class="cth-slide cth-slide--case-cards" data-cth-type="case-cards">
  <div class="cth-slide__head"><h2 class="cth-title">{{ title }}</h2>{{ ex.exBadge() }}</div>
  <div class="cth-slide__body cth-grid{% if (cards | length) > 4 %} cth-grid--3{% else %} cth-grid--2{% endif %}">
    {% for card in cards %}
    <div class="cth-panel cth-case-card">
      {% if card.image %}<img src="{{ card.image }}" alt="" style="width:100%;border-radius:6px;margin-bottom:0.35rem;" />{% elif card.logo %}<div class="cth-card-logo">{{ card.name }}</div>{% elif example %}{{ ex.phImg() }}{% endif %}
      {% if card.stat %}<p class="cth-case-card__stat">{{ card.stat }}</p>{% endif %}
      <p class="cth-card__title">{{ card.name }}</p>
      <p class="cth-card__text">{{ card.text }}</p>
    </div>
    {% endfor %}
  </div>
  {% if notes %}<aside class="notes">{{ notes }}</aside>{% endif %}
</section>