{% import "macros.njk" as ex %}
<section class="cth-slide cth-slide--contents" data-cth-type="contents">
  <div class="cth-contents">
    <div>
      <p class="cth-eyebrow">Example</p>
      <h2 class="cth-title">Contents</h2>
      <ol class="cth-contents__list">{% for item in items %}<li>{{ item }}</li>{% endfor %}</ol>
    </div>
    {% if image or example %}
    <div>{% if image %}<img src="{{ image }}" alt="" style="border-radius:8px;" />{% else %}{{ ex.phImg("min-height:14rem;") }}{% endif %}</div>
    {% endif %}
  </div>
  {% if notes %}<aside class="notes">{{ notes }}</aside>{% endif %}
</section>