<section class="cth-slide cth-slide--contact" data-cth-type="contact">
  <div class="cth-slide__head"><h2 class="cth-title">{{ title }}</h2><span class="cth-badge-example">Example</span></div>
  <div class="cth-slide__body">
    <div class="cth-contact-grid">
      {% for person in people %}
      <div class="cth-panel">
        <p class="cth-person__name">{{ person.name }}</p>
        <p class="cth-person__role">{{ person.role }}</p>
        {% if person.email %}<p style="font-size:0.6em;margin:0.25rem 0 0;">{{ person.email }}</p>{% endif %}
      </div>
      {% endfor %}
    </div>
    <div style="margin-top:0.5rem;">{% for link in links %}<span class="cth-link-chip">{{ link.kind }}</span>{% endfor %}</div>
  </div>
  {% if notes %}<aside class="notes">{{ notes }}</aside>{% endif %}
</section>