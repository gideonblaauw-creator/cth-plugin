{% import "macros.njk" as ex %}
<section class="cth-slide cth-slide--showcase" data-cth-type="showcase">
  <div class="cth-slide__head"><h2 class="cth-title">{{ title }}</h2>{{ ex.exBadge() }}</div>
  <div class="cth-slide__body cth-split">
    <div>
      <p>{{ text }}</p>
      {% if link %}<p style="font-size:0.6em;margin-top:0.35rem;">{{ link }}</p>{% endif %}
    </div>
    <div class="cth-showcase-imgs cth-showcase-imgs--{{ images | length }}">
      {% for img in images %}
      {% if img %}<img src="{{ img }}" alt="" class="cth-showcase-img" style="min-height:3rem;object-fit:cover;" />{% elif example %}{{ ex.phImg() }}{% endif %}
      {% endfor %}
    </div>
  </div>
  {% if notes %}<aside class="notes">{{ notes }}</aside>{% endif %}
</section>