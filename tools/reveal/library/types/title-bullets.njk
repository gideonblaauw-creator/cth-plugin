{% import "macros.njk" as ex %}
<section class="cth-slide cth-slide--title-bullets" data-cth-type="title-bullets">
  <div class="cth-slide__head">
    {% if eyebrow %}<p class="cth-eyebrow">{{ eyebrow }}</p>{% endif %}
    <h2 class="cth-title">{{ title }}</h2>
    {{ ex.exBadge() }}
  </div>
  <div class="cth-slide__body">
    {% if columns %}
    <div class="cth-split">
      {% for col in columns %}
      <ul class="cth-bullets">{% for b in col %}<li>{{ b }}</li>{% endfor %}</ul>
      {% endfor %}
    </div>
    {% elif bullets %}
    <ul class="cth-bullets">{% for b in bullets %}<li>{{ b }}</li>{% endfor %}</ul>
    {% endif %}
  </div>
  {% if notes %}<aside class="notes">{{ notes }}</aside>{% endif %}
</section>