<section class="cth-slide cth-slide--team-grid" data-cth-type="team-grid">
  <div class="cth-slide__head"><h2 class="cth-title">{{ title }}</h2><span class="cth-badge-example">Example</span></div>
  <div class="cth-slide__body cth-grid{% if (people | length) > 6 %} cth-grid--4{% elif (people | length) > 4 %} cth-grid--4{% else %} cth-grid--3{% endif %}">
    {% for person in people %}
    <div class="cth-person">
      {% if person.photo %}<img src="{{ person.photo }}" alt="" class="cth-avatar" style="width:2.5rem;height:2.5rem;object-fit:cover;" />{% else %}<div class="cth-avatar"></div>{% endif %}
      <p class="cth-person__name">{{ person.name }}</p>
      <p class="cth-person__role">{{ person.role }}</p>
    </div>
    {% endfor %}
  </div>
  {% if notes %}<aside class="notes">{{ notes }}</aside>{% endif %}
</section>