{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cleantechhub.net/schemas/routines-manifest.schema.json",
  "title": "CTH routines manifest",
  "description": "Central registry of confirmed and unverified agent routines (fleet plan 3.1).",
  "type": "object",
  "required": ["manifest_owner", "manifest_owner_agent_id", "updated", "routines"],
  "properties": {
    "manifest_owner": {
      "type": "string",
      "const": "Control Tower · Infra"
    },
    "manifest_owner_agent_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "routines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "agent_id",
          "agent_name",
          "routine_name",
          "schedule",
          "runner",
          "status",
          "owner_desk",
          "last_run_artifact_path",
          "source"
        ],
        "properties": {
          "agent_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "agent_name": { "type": "string" },
          "routine_name": { "type": "string" },
          "schedule": { "type": "string" },
          "runner": {
            "type": "string",
            "enum": ["local_automation", "cloud", "hands", "grok_routine", "unknown"]
          },
          "status": {
            "type": "string",
            "enum": ["active", "paused", "disabled", "unknown"]
          },
          "owner_desk": { "type": "string" },
          "last_run_artifact_path": { "type": "string" },
          "source": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}