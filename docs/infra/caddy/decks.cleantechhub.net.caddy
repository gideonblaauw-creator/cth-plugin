handle /rein-funding {
	redir * /rein-funding/ 308
}
handle_path /rein-funding/* {
	header X-Robots-Tag "noindex, nofollow"
	# Public deck only. Working files stay on disk and 404.
	@funding_nondeck not path / /index.html /shell/*.css /shell/*.js /fonts/* /slides/*.html
	handle @funding_nondeck {
		respond "Not found" 404
	}
	root * /opt/cth-decks/rein-funding
	file_server
}

handle /rein-academic-city-ghana {
	redir * /rein-academic-city-ghana/ 308
}
handle_path /rein-academic-city-ghana/* {
	header X-Robots-Tag "noindex, nofollow"
	# Public deck only: index, shell css/js, fonts, slides. index.html also loads fonts/*.woff2.
	@ghana_nondeck not path / /index.html /shell/*.css /shell/*.js /fonts/* /slides/*.html
	handle @ghana_nondeck {
		respond "Not found" 404
	}
	root * /opt/cth-decks/rein-academic-city-ghana
