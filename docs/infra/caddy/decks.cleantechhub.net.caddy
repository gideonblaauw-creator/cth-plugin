# decks.cleantechhub.net — CTH client decks.
# Same Appwrite upstream as wiki /decks/<slug>/ (Host <slug>.sites.localhost -> 127.0.0.1:9080).
# / /index.html /decks.json are the public dashboard. /<slug>/ stays open.
# Rollback of dashboard auth: restore the timestamped backup of this file, caddy validate, systemctl reload caddy.

decks.cleantechhub.net {
	encode gzip zstd
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	@dashboard path / /index.html /decks.json /thumbs/*
	handle @dashboard {
		root * /opt/cth-decks/index-dashboard
		header X-Robots-Tag "noindex, nofollow"
		header Cache-Control "no-store"
		file_server
	}

	handle /rein {
		redir * /rein/ 308
	}
	handle_path /rein/* {
		basic_auth {
			REIN $2a$14$UEAkrKVm.05H5ogjRki/z.WImQk1VEdk.fVUBzPXhw6qlVRsZbTGa
		}
		root * /opt/cth-decks/rein-index
		header X-Robots-Tag "noindex, nofollow"
		header Cache-Control "no-store"
		file_server
	}

handle /cth-clp26 {
	redir * /cth-clp26/ 308
}
handle_path /cth-clp26/* {
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy 127.0.0.1:9080 {
		header_up Host cth-clp26.sites.localhost
	}
}
