# Install on VPS as /etc/oauth2-proxy/oauth2-proxy.cfg (640, root:oauth2-proxy).
# Secrets from Infisical cth-agents prod / — never commit values.

provider = "google"
http_address = "127.0.0.1:4180"
redirect_url = "https://auth.cleantechhub.net/oauth2/callback"
email_domains = ["cleantechhub.net"]
authenticated_emails_file = "/etc/oauth2-proxy/allowlist.txt"
cookie_domains = [".cleantechhub.net"]
whitelist_domains = [".cleantechhub.net"]
reverse_proxy = true
set_xauthrequest = true
skip_provider_button = false
ping_path = "/oauth2/ping"
skip_auth_routes = ["/oauth2/ping"]
