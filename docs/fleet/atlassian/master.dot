digraph master {
  graph [
    label="CTH Fleet ↔ Atlassian master wiring v2 · 25 Nov 2026"
    labelloc=t
    fontsize=18
    splines=polyline
    rankdir=TB
    bgcolor=white
    nodesep=0.55
    ranksep=0.85
    newrank=true
  ];
  node [fontname="Arial", fontsize=14, style=filled, penwidth=1.2];
  edge [fontname="Arial", fontsize=12, color="#333333"];

  subgraph cluster_b1 {
    label="Band 1 · Approver";
    color="#B2EEFA";
    style=rounded;
    margin=16;
    GID [label="Gideon Blaauw", fillcolor="#06325C", fontcolor=white, shape=box];
    HITL_SP [label="Gideon yes", shape=diamond, fillcolor="#C62828", fontcolor=white];
    HITL_DEP [label="Gideon yes", shape=diamond, fillcolor="#C62828", fontcolor=white];
    GID -> HITL_SP [label="send/post ask"];
    GID -> HITL_DEP [label="merge/deploy ask"];
  }

  subgraph cluster_b2 {
    label="Band 2 · Desks";
    color="#B2EEFA";
    style=rounded;
    margin=16;
    ORCH [label="Orchestrator", fillcolor="#0C498A", fontcolor=white];
    INT [label="Internal desks", fillcolor="#0C498A", fontcolor=white];
    CLI [label="Client desks · 28", fillcolor="#0C498A", fontcolor=white];
    ORCH -> INT [label="domain desks"];
    ORCH -> CLI [label="client desks"];
  }

  subgraph cluster_b3 {
    label="Band 3 · Workbenches and Cloud Hands";
    color="#B2EEFA";
    style=rounded;
    margin=16;
    GMAIL [label="Gmail Workbench", fillcolor="#B2EEFA", fontcolor="#0C498A"];
    SLACK [label="Slack Workbench", fillcolor="#B2EEFA", fontcolor="#0C498A"];
    HAND [label="Cloud Hands", fillcolor="#B2EEFA", fontcolor="#0C498A"];
    N8N [label="n8n VPS", fillcolor=white, color="#F5A623", penwidth=2.5];
    OPSCH [label="#cth-ops-approvals", fillcolor="#0C498A", fontcolor=white, shape=box];
    GMAIL -> N8N [label="mail stub only"];
    SLACK -> N8N [label="Slack layer"];
    HAND -> N8N [label="bc-id PR receipt"];
    N8N -> OPSCH [label="CTH OPS Bot · card\\nJira+agent+bc-id/PR"];
    GID -> OPSCH [label="GO button"];
    OPSCH -> GMAIL [label="approve send"];
    OPSCH -> SLACK [label="approve post"];
    OPSCH -> HAND [label="approve merge"];
  }

  subgraph cluster_b4 {
    label="Band 4 · Systems and data";
    color="#B2EEFA";
    style=rounded;
    margin=16;
    JCORE [label="Jira core\\nCTHORCH OPS HANDS INT", fillcolor="#669348", fontcolor=white];
    JCLI [label="Client Jira · 28", fillcolor="#669348", fontcolor=white];
    HUB [label="Confluence CTHHUB", fillcolor="#669348", fontcolor=white];
    DOC [label="Doctor_Bot VPS", fillcolor=white, color="#69B5FA"];
    VAULT [label="Infisical", fillcolor=white, color="#69B5FA"];
    INT -> JCORE [label="desk work items"];
    CLI -> JCLI [label="client work items"];
    N8N -> VAULT [label="fetch tokens"];
    N8N -> JCORE [label="agent_id on issue"];
    N8N -> HUB [label="runbook pages"];
    DOC -> JCORE [label="doctor→CTHOPS"];
    JCORE -> HUB [label="gadget links"];
    JCLI -> HUB [label="hub child page"];
    OPSCH -> JCORE [label="writeback\\napprover+time+decision"];
  }

  GID -> ORCH [label="fleet route"];
  GID -> JCORE [label="accountable field", style=dashed];
  HITL_SP -> OPSCH [label="{Gideon yes} gate"];
  HITL_DEP -> OPSCH [label="{Gideon yes} gate"];
  ORCH -> JCORE [label="dashboard read"];
  ORCH -> HUB [label="home hub"];

  { rank=min; GID; }
  { rank=same; ORCH; }
  { rank=same; N8N; OPSCH; }
  { rank=same; JCORE; }

  band1 [style=invis, width=0.01, height=0.01, label=""];
  band2 [style=invis, width=0.01, height=0.01, label=""];
  band3 [style=invis, width=0.01, height=0.01, label=""];
  band4 [style=invis, width=0.01, height=0.01, label=""];

  GID -> band1 [style=invis, weight=10];
  band1 -> band2 [style=invis, weight=10];
  band2 -> band3 [style=invis, weight=10];
  band3 -> band4 [style=invis, weight=10];

  band1 -> GID [style=invis];
  band2 -> ORCH [style=invis];
  band3 -> N8N [style=invis];
  band4 -> JCORE [style=invis];

  subgraph cluster_legend {
    label="Legend";
    color="#E8E8E8";
    style="rounded,filled";
    bgcolor="#FAFAFA";
    margin=12;
    fontname="Arial";
    fontsize=14;
    { rank=same;
      LEG_A [label="Approver", fillcolor="#06325C", fontcolor=white];
      LEG_D [label="Desk / HITL channel", fillcolor="#0C498A", fontcolor=white];
      LEG_W [label="Workbench", fillcolor="#B2EEFA", fontcolor="#0C498A"];
      LEG_N [label="New / hub", fillcolor="#669348", fontcolor=white];
      LEG_P [label="In progress", fillcolor=white, color="#F5A623", penwidth=2.5];
      LEG_H [label="Gideon yes", shape=diamond, fillcolor="#C62828", fontcolor=white];
    }
  }

  band4 -> LEG_A [style=invis, weight=5];
  { rank=max; LEG_A; }
}