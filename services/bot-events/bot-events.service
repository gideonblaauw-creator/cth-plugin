# systemd unit template — install on OVH VPS only after Gideon's GO
# Copy to /etc/systemd/system/bot-events.service and adjust paths.

[Unit]
Description=CleantechHUB bot activity event log
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/cleantechhub/bot-events
Environment=BOT_EVENTS_DB=/var/lib/cleantechhub/bot-events/events.db
Environment=BOT_EVENTS_PORT=8795
Environment=BOT_EVENTS_HOST=127.0.0.1
# Token is injected at runtime — do not store in this file.
ExecStart=/usr/bin/infisical run --projectId c84fe8b3 --env prod --path / -- node server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cleantechhub/bot-events

[Install]
WantedBy=multi-user.target
